# Compile-time checks and compiler options
CONFIG_FRAME_WARN=4096

# Kernel version string
CONFIG_LOCALVERSION="-KaYuKernel"
# CONFIG_LOCALVERSION_AUTO is not set

# Input Device Drivers
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_FOD=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=y
# monet's goodix FOD is powered through goodix,gpio-pwr (tlmm 68), not a
# fp_vdd_vreg regulator; enabling FP_VREG_CONTROL compiles out GF_PW_CTL and
# leaves the sensor unpowered, so the HAL fails to open it.
# CONFIG_FINGERPRINT_FPC_TEE is not set
# CONFIG_FINGERPRINT_FP_VREG_CONTROL is not set
# CONFIG_FPR_FPC is not set

# TI Technologies, Inc. Charger support
CONFIG_BQ2597X_CHARGE_PUMP=y
# monet has no ds28e16 authentication IC in DT. With BATT_VERIFY enabled the
# QG driver matches battery profiles by the literal name "Nonstandard" instead
# of by batt-id, so no profile loads and capacity is pinned to 50%.
# CONFIG_BATT_VERIFY_BY_DS28E16 is not set
# CONFIG_ONEWIRE_GPIO is not set

# Media drivers
CONFIG_MI7250_CAMERA=y

# Multifunction device drivers
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Pseudo filesystems
CONFIG_EROFS_FS=y
CONFIG_FUSE_BPF=y

# Qualcomm RmNet extensions
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# Qualcomm Atheros CLD WLAN module
CONFIG_QCA_CLD_WLAN=y

# RCU Subsystem
CONFIG_LOG_BUF_SHIFT=21

# USB GPIO expanders
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_G7A_CHG=y

# Xiaomi Family
CONFIG_BOARD_XIAOMI=y
CONFIG_BOARD_XIAOMI_SM7250=y
CONFIG_BOARD_MONET=y

# KernelSU (backslashxx/KernelSU) with SUSFS
CONFIG_KSU=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
