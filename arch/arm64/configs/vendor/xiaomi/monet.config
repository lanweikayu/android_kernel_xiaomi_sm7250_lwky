# Compile-time checks and compiler options
CONFIG_FRAME_WARN=4096

# Kernel version string
CONFIG_LOCALVERSION="-perf-KSU-LWKY-Kernel"
# CONFIG_LOCALVERSION_AUTO is not set

# Input Device Drivers
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_FOD=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
# CONFIG_FPR_FPC is not set

# TI Technologies, Inc. Charger support
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y

# Media drivers
CONFIG_MI7250_CAMERA=y

# Multifunction device drivers
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Pseudo filesystems
CONFIG_EROFS_FS=y

# Qualcomm RmNet extensions
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# Qualcomm Atheros CLD WLAN module
CONFIG_QCA_CLD_WLAN=y

# RCU Subsystem
CONFIG_LOG_BUF_SHIFT=21

# USB GPIO expanders
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_G7A_CHG=y

# Xiaomi Family
CONFIG_BOARD_XIAOMI=y
CONFIG_BOARD_XIAOMI_SM7250=y
CONFIG_BOARD_MONET=y

# KernelSU (backslashxx/KernelSU) with SUSFS
CONFIG_KSU=y
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
