# Compile-time checks and compiler options
CONFIG_FRAME_WARN=4096

# Input Device Drivers
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
# CONFIG_FPR_FPC is not set

# TI Technologies, Inc. Charger support
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_ONEWIRE_GPIO=y

# Media drivers
CONFIG_MI7250_CAMERA=y

# Multifunction device drivers
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Pseudo filesystems
CONFIG_EROFS_FS=y

# Qualcomm RmNet extensions
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# Qualcomm Atheros CLD WLAN module
CONFIG_QCA_CLD_WLAN=y

# RCU Subsystem
CONFIG_LOG_BUF_SHIFT=21

# USB GPIO expanders
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_G7A_CHG=y

# Xiaomi Family
CONFIG_BOARD_XIAOMI=y
CONFIG_BOARD_XIAOMI_SM7250=y
CONFIG_BOARD_PICASSO=y
